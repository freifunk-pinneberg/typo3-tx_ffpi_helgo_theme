{
  "name": "ffpi/ffpi-helgo-theme",
  "description": "Theme for Freifunk Helgoland",
  "homepage": "https://pinneberg.freifunk.net",
  "license": "GPL-3.0-or-later",
  "type": "typo3-cms-extension",
  "authors": [
    {
      "name": "Kevin Quiatkowski",
      "role": "Developer"
    }
  ],
  "support": {
    "forum": "https://pinneberg.freifunk.net/forum/"
  },
  "keywords": [
    "Freifunk",
    "Helgoland",
    "Theme"
  ],
  "replace": {
    "typo3-ter/ffpi-helgo-theme": "self.version"
  },
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^12.4 || ^13.4",
    "ffpi/ffpi-theme": "*"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "ffpi_helgo_theme"
    }
  },
  "autoload": {
    "psr-4": {}
  },
  "autoload-dev": {
    "psr-4": {}
  }
}
